<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ArtifactViewer</AssemblyName>
    <RootNamespace>ArtifactViewer</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Shown in the exe's Properties → Details, so it's set explicitly rather
       than defaulting to the assembly name. Keep it project-identity only. -->
  <PropertyGroup>
    <Product>Artifact Viewer</Product>
    <Company>claude-artifact-viewer contributors</Company>
    <Copyright>MIT — claude-artifact-viewer contributors</Copyright>
    <Description>Local folder-watching artifact renderer for Claude Code.</Description>
    <!-- The update notice compares the latest release tag against this, so a
         release tag of vX.Y.Z needs this at X.Y.Z or up-to-date installs are
         told they're behind. The release workflow fails the build if they
         disagree. -->
    <Version>1.4.0</Version>
  </PropertyGroup>

  <!-- Single-file release defaults, so `dotnet publish -c Release -r win-x64`
       produces the one-file download with no extra switches.
       PublishTrimmed is deliberately absent: unsupported for WPF, and it
       breaks XAML reflection at runtime. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
    <!-- Without this, the WebView2 packages' IntelliSense .xml files publish
         alongside the exe and it stops being a one-file download. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <!-- Seeded into the watch folder on first run. Embedded with an explicit
         logical name so the single-file exe carries it and lookup doesn't
         depend on namespace-mangled resource paths. -->
    <EmbeddedResource Include="assets\welcome.md" LogicalName="welcome.md" />
    <!-- Vendored render libraries, extracted to the render folder at startup.
         Local rather than CDN so rendering works offline, doesn't stall a PDF
         export waiting on a network fetch, and can't change under us.
         See THIRD-PARTY-NOTICES.md for licences. -->
    <EmbeddedResource Include="assets\lib\mermaid.min.js" LogicalName="mermaid.min.js" />
    <EmbeddedResource Include="assets\lib\highlight.min.js" LogicalName="highlight.min.js" />
    <EmbeddedResource Include="assets\lib\highlight-dark.min.css" LogicalName="highlight-dark.min.css" />
    <!-- Grammars absent from highlight.js's "common" bundle. Two files (6 KB)
         rather than the full build (~1.2 MB) for the two languages the README
         actually advertises. -->
    <EmbeddedResource Include="assets\lib\powershell.min.js" LogicalName="powershell.min.js" />
    <EmbeddedResource Include="assets\lib\dos.min.js" LogicalName="dos.min.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
