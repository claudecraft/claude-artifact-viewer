<Window x:Class="ArtifactViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Artifact Viewer"
        Icon="app.ico"
        Width="1000" Height="750"
        Background="#1E1E1E"
        PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <!-- Flat dark toolbar button -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5A5A5A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#0E639C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- File tab -->
        <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bg" Background="Transparent" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent" Padding="12,6,12,4" Margin="0,0,2,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="#D4D4D4"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#252526"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#0E9CDB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Background="#2D2D30" LastChildFill="True">
            <ToggleButton x:Name="BtnSidebar" DockPanel.Dock="Left" Style="{StaticResource PinButton}"
                          Content="&#x2630;" Margin="6,4,0,4" ToolTip="Toggle file list"
                          Checked="BtnSidebar_Changed" Unchecked="BtnSidebar_Changed"/>
            <Button x:Name="BtnPrev" DockPanel.Dock="Left" Style="{StaticResource NavButton}"
                    Content="&#x25C0;" Margin="2,4,0,4" Click="BtnPrev_Click" ToolTip="Older (Alt+Left)"/>
            <Button x:Name="BtnNext" DockPanel.Dock="Left" Style="{StaticResource NavButton}"
                    Content="&#x25B6;" Margin="2,4,0,4" Click="BtnNext_Click" ToolTip="Newer (Alt+Right)"/>

            <ToggleButton x:Name="BtnPin" DockPanel.Dock="Right" Style="{StaticResource PinButton}"
                          Content="&#x1F4CC;" Margin="0,4,6,4" ToolTip="Always on top"
                          Checked="BtnPin_Changed" Unchecked="BtnPin_Changed"/>
            <Button x:Name="BtnFolder" DockPanel.Dock="Right" Style="{StaticResource NavButton}"
                    Content="&#x1F4C1;" Margin="0,4,2,4" Click="BtnFolder_Click"
                    MouseRightButtonUp="BtnFolder_RightClick"
                    ToolTip="Open watched folder (right-click to change it)"/>
            <Button x:Name="BtnKeep" DockPanel.Dock="Right" Style="{StaticResource NavButton}"
                    Content="&#x1F4E5;" Margin="0,4,2,4" Click="BtnKeep_Click"
                    MouseRightButtonUp="BtnKeep_RightClick"
                    ToolTip="Keep: copy this file to your keep folder (right-click to change it)"/>
            <TextBlock x:Name="TxtCounter" DockPanel.Dock="Right" Foreground="#8A8A8A"
                       VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12" Text=""/>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock x:Name="TxtTitle" Foreground="White" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Text="Waiting for artifacts…" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtDate" Foreground="#8A8A8A" FontSize="12"
                           VerticalAlignment="Center" Margin="10,1,0,0" Text=""/>
            </StackPanel>
        </DockPanel>

        <!-- Tab strip: one tab per file, oldest → newest -->
        <ListBox x:Name="TabStrip" Grid.Row="1" Background="#1E1E1E" BorderThickness="0"
                 ItemContainerStyle="{StaticResource TabItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 SelectionChanged="TabStrip_SelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.ContextMenu>
                            <!-- DataContext is inherited from the placement target, so the
                                 handlers read the tab's FileEntry the same way the × does -->
                            <ContextMenu Background="#2D2D30" BorderBrush="#3F3F46">
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Foreground" Value="#D4D4D4"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="Export to PDF…" Click="TabExportPdf_Click"/>
                                <Separator/>
                                <MenuItem Header="Close tab" Click="TabClose_Click"/>
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                        <Button Click="TabClose_Click" ToolTip="Close (hides until rewritten)"
                                Content="&#x2715;" FontSize="9" Margin="7,0,0,0" Padding="3,1"
                                VerticalAlignment="Center" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="#8A8A8A"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Visibility" Value="Hidden"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" Background="{TemplateBinding Background}"
                                                        CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#4A4A4A"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Sidebar + viewer -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="Sidebar" Grid.Column="0" Background="#252526" Width="230"
                    Visibility="Collapsed" BorderBrush="#333" BorderThickness="0,0,1,0">
                <ListBox x:Name="SideList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="SideList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bg" Background="Transparent" Padding="14,8" BorderThickness="2,0,0,0"
                                                BorderBrush="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#2A2A2A"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#2D2D30"/>
                                                <Setter TargetName="bg" Property="BorderBrush" Value="#0E9CDB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding Entry.Name}" Foreground="#D4D4D4" FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Entry.LastWrite, StringFormat='MMM d, h:mm:ss tt'}"
                                               Foreground="#7A7A7A" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Click="SideTrash_Click" Content="&#x1F5D1;"
                                        FontSize="12" Padding="4,2" Margin="6,0,0,0"
                                        VerticalAlignment="Center" Cursor="Hand"
                                        ToolTip="Delete file (Recycle Bin)">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Foreground" Value="#8A8A8A"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Visibility" Value="Hidden"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#6B2B2B"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Background="#1E1E1E">
                <Grid>
                    <TextBlock x:Name="TxtEmpty" Foreground="#6A6A6A" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center"
                               Text="No artifacts yet.&#x0a;Files dropped into the watched folder will appear here."/>
                    <wv2:WebView2 x:Name="Web" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
